# Leave blank to use Vite's local Functions proxy in development.
# Set explicitly to a verified deployed backend to use live APIs locally.
VITE_API_BASE_URL=
# Set true only when Auth, Firestore, Functions and Storage emulators are running.
VITE_USE_FIREBASE_EMULATORS=false
VITE_SITE_URL=https://drixelsa.co.za
# Optional, after verifying image URLs on the chosen host.
VITE_EMAIL_ASSET_BASE_URL=

# Free Cloudflare backend: npm --prefix worker run dev in another terminal.
VITE_API_MODE=worker

# Enable only after Firebase Hosting and Google OAuth redirect setup is verified.
VITE_FIREBASE_AUTH_DOMAIN=drixel-sa.firebaseapp.com

# Drixel ID first-party SSO (public SPA values; never add a client secret).
VITE_DRIXEL_ID_ISSUER=https://dev-4pc3eomoyq8oy6o4.us.auth0.com/
VITE_DRIXEL_ID_AUTHORIZATION_ENDPOINT=https://dev-4pc3eomoyq8oy6o4.us.auth0.com/authorize
VITE_DRIXEL_ID_TOKEN_ENDPOINT=https://dev-4pc3eomoyq8oy6o4.us.auth0.com/oauth/token
VITE_DRIXEL_ID_AUDIENCE=https://api.drixel-platform
VITE_DRIXEL_ID_CLIENT_ID=
