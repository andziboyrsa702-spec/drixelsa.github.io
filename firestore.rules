rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email_verified', false) == true &&
         request.auth.token.get('email', '') in ['admin@drixelsa.co.za', 'drixelsa@gmail.com']));
    }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{id} { allow read, write: if isAdmin(); }
    match /settings/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && (id != 'store_config' ||
        request.resource.data.keys().hasOnly(['deliveryFee','freeDeliveryThreshold','updatedAt']));
    }
    match /orders/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      // All creation, prices, status transitions and inventory operations run on the server.
      allow write: if false;
    }
    match /carts/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items','updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 50;
    }
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'customer') == 'customer'
        && !request.resource.data.keys().hasAny(['admin','customClaims']);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','admin','customClaims','uid']));
      allow delete: if isAdmin();
    }
    match /subscribers/{id} { allow read: if isAdmin(); allow write: if false; }
    match /contacts/{id} { allow read: if isAdmin(); allow write: if false; }
    match /mail_jobs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /order_audit/{id} { allow read: if isAdmin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
