rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminDeviceVerified() {
      return !exists(/databases/$(database)/documents/security_config/admin)
        || !get(/databases/$(database)/documents/security_config/admin).data.get('passkeysRequired', false)
        || (exists(/databases/$(database)/documents/admin_security/$(request.auth.uid))
          && get(/databases/$(database)/documents/admin_security/$(request.auth.uid)).data.get('enabled', false)
          && request.auth.token.get('drixel_admin_key_version', '') == get(/databases/$(database)/documents/admin_security/$(request.auth.uid)).data.version
          && request.auth.token.get('drixel_admin_verified_at', 0) * 1000 <= request.time.toMillis()
          && request.auth.token.get('drixel_admin_verified_at', 0) * 1000 > request.time.toMillis() - 900000);
    }
    function isAdmin() {
      return signedIn() && adminDeviceVerified() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        (request.auth.token.get('email_verified', false) == true &&
         request.auth.token.get('email', '') in ['admin@drixelsa.co.za', 'drixelsa@gmail.com'])
      );
    }
    function ownsOrder() {
      return signedIn() && (
        (resource.data.keys().hasAny(['customer']) && resource.data.customer.get('uid','') == request.auth.uid) ||
        (resource.data.keys().hasAny(['userId']) && resource.data.userId == request.auth.uid)
      );
    }

    match /security_events/{id} { allow read: if isAdmin(); allow write: if false; }
    function validReview() {
      let d=request.resource.data;
      return d.keys().hasOnly(['productId','userId','author','body','rating','status','updatedAt'])
        && d.userId==request.auth.uid && d.productId is string
        && exists(/databases/$(database)/documents/products/$(d.productId))
        && d.author is string && d.author.size()>0 && d.author.size()<=60
        && d.body is string && d.body.size()>=10 && d.body.size()<=1500
        && d.rating is int && d.rating>=1 && d.rating<=5
        && d.status=='pending' && d.updatedAt==request.time;
    }
    match /product_reviews/{id} {
      allow read: if isAdmin() || resource.data.status=='published' || (signedIn() && resource.data.userId==request.auth.uid);
      allow create: if signedIn() && id==request.resource.data.productId+'_'+request.auth.uid && validReview();
      allow update: if isAdmin() || (signedIn() && resource.data.userId==request.auth.uid && id==request.resource.data.productId+'_'+request.auth.uid && validReview());
      allow delete: if isAdmin();
    }
    match /customer_feedback/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId==request.auth.uid);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['userId','category','orderReference','message','status','createdAt'])
        && request.resource.data.userId==request.auth.uid && request.resource.data.status=='new'
        && request.resource.data.category in ['General feedback','Fit & sizing','Delivery concern','Product quality','Website issue','Privacy concern']
        && request.resource.data.orderReference is string && request.resource.data.orderReference.size()<=100
        && request.resource.data.message is string && request.resource.data.message.size()>=10 && request.resource.data.message.size()<=3000
        && request.resource.data.createdAt==request.time;
      allow update,delete: if isAdmin();
    }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{id} { allow read, write: if isAdmin(); }
    match /collections/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if isAdmin() || (id in ['store','storefront'] && !resource.data.keys().hasAny(['resendApiKey','yocoSecretKey','RESEND_API_KEY','YOCO_SECRET_KEY','FIREBASE_SERVICE_ACCOUNT','RESEND_WEBHOOK_SECRET','YOCO_WEBHOOK_SECRET','SNAPSCAN_API_KEY','SNAPSCAN_WEBHOOK_AUTH_KEY','CLOUDINARY_API_SECRET','cloudinaryApiSecret','snapscanApiKey','snapscanWebhookAuthKey','firebaseServiceAccount'])); allow write: if isAdmin(); }
    match /fx_rates/{id} { allow read, write: if isAdmin(); }
    match /returns/{id} { allow read, write: if isAdmin(); }
    match /audit_logs/{id} { allow read, create: if isAdmin(); allow update, delete: if false; }
    match /order_audit/{id} { allow read: if isAdmin(); allow write: if false; }
    match /inventory_adjustments/{id} { allow read, create: if isAdmin(); allow update, delete: if false; }
    match /mail_jobs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /checkout_attempts/{id} { allow read, write: if false; }
    match /pending_payments/{id} { allow read, write: if isAdmin(); }
    match /yoco_purchases/{id} { allow read, write: if isAdmin(); }
    match /snapscan_purchases/{id} { allow read, write: if isAdmin(); }

    match /orders/{id} {
      allow create: if false;
      allow read: if isAdmin() || ownsOrder();
      allow update, delete: if false;
    }

    match /carts/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'customer') == 'customer'
        && !request.resource.data.keys().hasAny(['admin','customClaims']);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','admin','customClaims','uid']));
      allow delete: if isAdmin();
    }

    match /subscribers/{id} { allow read, create, update, delete: if isAdmin(); }
    match /email_campaigns/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == 'draft';
      allow update: if isAdmin() && resource.data.status == 'draft' && request.resource.data.status == 'draft';
      allow delete: if isAdmin() && resource.data.status == 'draft';
    }
    match /campaign_jobs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /email_deliveries/{id} { allow read: if isAdmin(); allow write: if false; }
    match /email_events/{id} { allow read: if isAdmin(); allow write: if false; }
    match /email_suppressions/{id} { allow read: if isAdmin(); allow write: if false; }
    match /operations_health/{id} { allow read: if isAdmin(); allow write: if false; }
    match /media_assets/{id} { allow read, write: if isAdmin(); }
    match /campaign_keys/{id} { allow read, write: if false; }
    match /contacts/{id} { allow read, update, delete: if isAdmin(); allow create: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
