rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    function ownsOrder() {
      return signedIn() && (
        resource.data.customer.uid == request.auth.uid ||
        resource.data.customer.email == request.auth.token.email
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Orders are created by trusted backend checkout code. Customers may only
      // read their own orders; payment and fulfillment mutations stay privileged.
      allow create: if false;
      allow read: if isAdmin() || ownsOrder();
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Operational collections: customer writes are intentionally restricted.
    match /subscribers/{subscriberId} {
      // Public newsletter mutations go through server-side endpoints.
      allow read, create, update, delete: if isAdmin();
    }

    match /email_campaigns/{campaignId} {
      allow read, create, update, delete: if isAdmin();
    }


    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /returns/{returnId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /inventory_adjustments/{adjustmentId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /checkout_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /contacts/{contactId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /pending_payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /yoco_purchases/{purchaseId} {
      allow read, write: if isAdmin();
    }

    match /snapscan_purchases/{purchaseId} {
      allow read, write: if isAdmin();
    }

    match /carts/{cartId} {
      allow read, write: if signedIn() &&
        (request.auth.uid == cartId || isAdmin());
    }

    // Deny any collection not explicitly declared above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
