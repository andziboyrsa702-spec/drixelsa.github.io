rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'admin@drixelsa.co.za' ||
        request.auth.token.email == 'drixelsa@gmail.com'
      );
    }

    function ownsOrder() {
      return signedIn() &&
        resource.data.customer.email == request.auth.token.email;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Checkout is restricted to authenticated customers. Payment/order status
      // changes remain server/admin controlled rather than customer editable.
      allow create: if signedIn()
        && request.resource.data.customer.email == request.auth.token.email;
      allow read: if isAdmin() || ownsOrder();
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Operational collections: customer writes are intentionally restricted.
    match /subscribers/{subscriberId} {
      allow read, update, delete: if isAdmin();
      allow create: if
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.status == 'active';
    }

    match /email_campaigns/{campaignId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /pending_payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /yoco_purchases/{purchaseId} {
      allow read, write: if isAdmin();
    }

    match /snapscan_purchases/{purchaseId} {
      allow read, write: if isAdmin();
    }

    match /carts/{cartId} {
      allow read, write: if signedIn() &&
        (request.auth.uid == cartId || isAdmin());
    }

    // Deny any collection not explicitly declared above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
