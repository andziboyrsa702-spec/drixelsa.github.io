{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/market",
        "function": "market"
      },
      {
        "source": "/api/exchange-rates",
        "function": "exchangeRates"
      },
      {
        "source": "/api/admin/inventory-adjust",
        "function": "adminInventoryAdjust"
      },
      {
        "source": "/api/admin/order-action",
        "function": "adminOrderAction"
      },
      {
        "source": "/api/checkout-quote",
        "function": "checkoutQuote"
      },
      {
        "source": "/api/create-order",
        "function": "createOrder"
      },
      {
        "source": "/api/subscribe",
        "function": "subscribeNewsletter"
      },
      {
        "source": "/api/unsubscribe",
        "function": "unsubscribeNewsletter"
      },
      {
        "source": "/api/send-campaign",
        "function": "sendCampaign"
      },
      {
        "source": "/api/send-email",
        "function": "sendEmail"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
